# Copy to .env for local overrides. Dev defaults work without any real cloud account.

# Control plane (backend)
ConnectionStrings__Default=Host=localhost;Port=5432;Database=r8er;Username=r8er;Password=dev
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_PROJECT_ID=demo-r8er

# Frontend (Vite exposes only VITE_-prefixed vars)
VITE_API_URL=http://localhost:5028
VITE_FIREBASE_AUTH_EMULATOR=http://localhost:9099
VITE_FIREBASE_PROJECT_ID=demo-r8er

# Gateway (read from its own env, e.g. `R8ER_API_URL=... go run ./cmd/gateway` in gateway/)
R8ER_API_URL=http://localhost:5028      # control plane; unset = POC room mode only
R8ER_ENROLL_TOKEN=                          # one-time, from web app -> Add gateway; ignored once enrolled
R8ER_STATE_DIR=r8er-state                   # DTLS cert + credential; delete = brand-new gateway
R8ER_PAGE_PORT=8097                         # gateway's local page (Jellyfin owns 8096)
R8ER_LAN_URL=                               # override the advertised page URL (needed inside Docker)
R8ER_ORIGIN=http://localhost:8096           # tunnel origin (local Jellyfin)
# POC only: R8ER_SIGNAL_URL (room signaling), R8ER_ICE_URLS / _USERNAME / _CREDENTIAL (TURN)

# Backend: public URL baked into the gateway install command (prod; dev uses the request URL)
# R8ER_PUBLIC_URL=https://r8er.up.railway.app

# Local TURN (compose --profile relay); dev toggle forces relay in the client
VITE_TURN_URL=turn:localhost:3478
VITE_TURN_USER=dev
VITE_TURN_PASS=dev

# Production-only (never set locally): Cloudflare TURN API token, R2 credentials
# — provisioned at deploy time, human-approved. Also set in prod:
#   FIREBASE_PROJECT_ID=<real project>          (unset defaults to demo-r8er → logins fail)
#   FIREBASE_SERVICE_ACCOUNT_JSON=<sa key JSON>  (Firebase Admin credential; Railway has no ambient ADC)
#   ConnectionStrings__Default=Host=...;SSL Mode=Prefer;...  (keyword form, not the postgres:// URL)
