# Copy to .env for local overrides. Dev defaults work without any real cloud account.

# Control plane (backend)
ConnectionStrings__Default=Host=localhost;Port=5432;Database=streamiq;Username=streamiq;Password=dev
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_PROJECT_ID=demo-streamiq
CORS_ORIGINS=http://localhost:5173      # SPA origins allowed to call the API (comma-separated)

# Frontend (Vite exposes only VITE_-prefixed vars)
VITE_API_URL=http://localhost:5028
VITE_FIREBASE_AUTH_EMULATOR=http://localhost:9099
VITE_FIREBASE_PROJECT_ID=demo-streamiq

# Gateway: real env, or gateway.env next to the binary / in the working dir (real env wins).
# Dev: scripts/setup-jellyfin.sh writes gateway/gateway.env (origin, page port, key).
STREAMIQ_API_URL=http://localhost:5028      # control plane (required)
STREAMIQ_ENROLL_TOKEN=                          # one-time, from web app -> Add gateway; ignored once enrolled
STREAMIQ_STATE_DIR=streamiq-state                   # DTLS cert + credential; delete = brand-new gateway
STREAMIQ_PAGE_PORT=18097                        # local page; dev 18097, product default 8097 (installed copy)
STREAMIQ_NAME=                                  # gateway name at enrollment; unset = hostname
STREAMIQ_LAN_URL=                               # override the advertised page URL (needed inside Docker)
STREAMIQ_ICE_PORT=                              # Docker only: one published UDP port for ICE (sessions.NewAPI)
STREAMIQ_ORIGIN=http://localhost:18096          # tunnel origin; dev Jellyfin 18096, product default 8096
STREAMIQ_JELLYFIN_API_KEY=                      # gateway injects it; browsers never see it (dev: scripts/setup-jellyfin.sh)
STREAMIQ_JELLYFIN_USER=                         # Jellyfin user to stream as; unset = the only user
# Optional TURN for the gateway: STREAMIQ_ICE_URLS / _USERNAME / _CREDENTIAL (scripts/gen-turn-creds.ps1)

# Backend: public URL baked into the gateway install command (prod; dev uses the request URL)
# STREAMIQ_PUBLIC_URL=https://streamiq.up.railway.app

# Backend /turn, dev path: hand out the local coturn (compose --profile relay).
# Unset = STUN only. Force the relay path with ?relay in the app URL.
# STREAMIQ_TURN_URLS=turn:127.0.0.1:3478?transport=udp
# STREAMIQ_TURN_USERNAME=dev
# STREAMIQ_TURN_CREDENTIAL=dev

# Production-only (never set locally): CLOUDFLARE_TURN_KEY_ID + CLOUDFLARE_TURN_API_TOKEN (backend /turn), R2 credentials
# — provisioned at deploy time, human-approved. Also set in prod:
#   FIREBASE_PROJECT_ID=<real project>          (unset defaults to demo-streamiq → logins fail)
#   FIREBASE_SERVICE_ACCOUNT_JSON=<sa key JSON>  (Firebase Admin credential; Railway has no ambient ADC)
#   ConnectionStrings__Default=Host=...;SSL Mode=Prefer;...  (keyword form, not the postgres:// URL)
