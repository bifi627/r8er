<Project>
  <PropertyGroup>
    <!-- IDE style rules from /.editorconfig run in `dotnet build` and the IDE, not only `dotnet format`. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Zero-warning policy: warnings train everyone to ignore output. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Pinned so an SDK bump can't add rules and break the build; raise it deliberately with the SDK. -->
    <AnalysisLevel>10.0</AnalysisLevel>
  </PropertyGroup>
  <ItemGroup>
    <!-- Flags every null-forgiving `!` without a `// ! <why>` justification comment
         (NX0001-4; severities in /.editorconfig). Analyzer only, nothing ships. -->
    <PackageReference Include="Nullable.Extended.Analyzer" Version="1.18.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
