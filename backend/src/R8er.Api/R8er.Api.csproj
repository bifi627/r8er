<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>00ced353-38e6-46af-8ac2-654fc45e49ab</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="R8er.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- POC step 6: connectivity telemetry sink. Raw ADO.NET provider (no EF) —
         the throwaway spike table is a CREATE-IF-NOT-EXISTS + parameterized
         insert; kept as-is (POC code, do not touch). -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <!-- Task 1: decided ORM + migrations tooling (tenant data model, global
         tenant query filter). Npgsql bumped 9.0.3 -> 10.0.3 alongside it: the
         EF Postgres provider requires Npgsql >= 10.0.3 (NU1605 downgrade
         error otherwise); the POC telemetry code is source-compatible.
         EFCore.Relational is referenced explicitly so it flows to the test
         project at the EF lockstep version: Npgsql.EntityFrameworkCore.PostgreSQL
         10.0.3 only floors it at 10.0.4, and .Design (PrivateAssets) hides its
         10.0.x from referencing projects -> MSB3277 conflict otherwise.
         Bump all Microsoft.EntityFrameworkCore* together. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Task 2: Firebase ID-token verification (VerifyIdTokenAsync). Same call
         path in dev (emulator) and prod (real issuer) — the only .NET option
         honoring the no-auth-bypass rule. -->
    <PackageReference Include="FirebaseAdmin" Version="3.7.0" />
  </ItemGroup>

</Project>
